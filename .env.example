# ==============================================================================
# HIGHVIEW / PULSEHR-AI — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
#
# Copy this file to `.env` in the project root or configure these variables
# in your container / orchestration runtime (Docker, Kubernetes, Systemd).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER RUNTIME (TIER 3: Operational Environment)
# ------------------------------------------------------------------------------
HIGHVIEW_ENVIRONMENT=development             # development | test | staging | production
HIGHVIEW_PORT=8000                            # Backend FastAPI HTTP listening port
HIGHVIEW_PROJECT_NAME=HighView               # Application branding name
HIGHVIEW_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5175

# ------------------------------------------------------------------------------
# 2. STORAGE ROOTS & PERSISTENCE (TIER 3: Path Configuration)
# ------------------------------------------------------------------------------
# All paths can be absolute or relative to the project root.
HIGHVIEW_DATA_DIR=backend/data
HIGHVIEW_DB_PATH=backend/data/db/pulsehr.sqlite3
HIGHVIEW_UPLOADS_DIR=backend/data/uploads
HIGHVIEW_EXPORTS_DIR=backend/data/exports
HIGHVIEW_PARQUET_STORAGE_DIR=backend/data/datasets

# ------------------------------------------------------------------------------
# 3. INGESTION & DATASET CONSTRAINTS (TIER 3: Operational Guardrails)
# ------------------------------------------------------------------------------
HIGHVIEW_MAX_UPLOAD_MB=20                     # Maximum upload file size in megabytes (CSV / Excel)
HIGHVIEW_MAX_ROWS=20000                       # Maximum tabular rows processed per workbook
HIGHVIEW_MAX_COLUMNS=200                      # Maximum columns per sheet before rejection

# ------------------------------------------------------------------------------
# 4. PHASE G3 ANALYTICAL PLANE & DUCKDB (TIER 3: Resource Limits)
# ------------------------------------------------------------------------------
HIGHVIEW_DUCKDB_ANALYTICS_ENABLED=true
HIGHVIEW_G3_ANALYTICS_MODE=SHADOW             # SHADOW | CANARY | PRIMARY
HIGHVIEW_DUCKDB_MAX_MEMORY=2GB
HIGHVIEW_DUCKDB_THREADS=2
HIGHVIEW_PARQUET_COMPRESSION=snappy

# ------------------------------------------------------------------------------
# 5. LOCAL AI / LLM ENGINE & OLLAMA (TIER 3: Model Routing)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
HIGHVIEW_EMBEDDING_DIM=768

# ------------------------------------------------------------------------------
# 6. CRITIC & DECISION ENGINE (TIER 3: Engine Modes)
# ------------------------------------------------------------------------------
CRITIC_MODE=hybrid                            # hybrid | deterministic | legacy
CRITIC_SEMANTIC_MODEL=phi4-mini:latest
DECISION_ENGINE=rules                         # rules | embedding

# ------------------------------------------------------------------------------
# 7. PRESENTATION PIPELINE (TIER 3: Automation Tuning)
# ------------------------------------------------------------------------------
PRESENTATION_MEMORY_ENABLED=true
PRESENTATION_EMBEDDING_MODEL=nomic-embed-text:latest
PRESENTATION_MEMORY_TOP_K=8
PRESENTATION_MEMORY_MAX_CONTEXT_ITEMS=6
PRESENTATION_MEMORY_MAX_TOTAL_CHARS=4000
PRESENTATION_MEMORY_VECTOR_STORE=sqlite_vec

PRESENTATION_DIRECTOR_ENABLED=true
PRESENTATION_DIRECTOR_MODEL=qwen3.5:9b
PRESENTATION_DIRECTOR_MAX_RETRIES=2
PRESENTATION_DEFAULT_SLIDE_COUNT_MODE=ADAPTIVE

PRESENTATION_ORCHESTRATOR_ENABLED=true
PRESENTATION_ORCHESTRATOR_MODEL=granite4:3b-h
PRESENTATION_ORCHESTRATOR_FALLBACK_MODEL=granite4:3b
PRESENTATION_ANALYTICAL_MODEL=phi4-mini:latest
PRESENTATION_DEEP_REASONING_MODEL=deepseek-r1:7b
PRESENTATION_ENABLE_DEEP_REASONING=true

PRESENTATION_VISUAL_ENGINE_ENABLED=true
PRESENTATION_LAYOUT_SYSTEM=scoped_bootstrap
PRESENTATION_CHART_ENGINE=echarts
PRESENTATION_ENABLE_ADVANCED_CHARTS=true
PRESENTATION_ENABLE_ANIMATIONS=true
PRESENTATION_ENABLE_ACCESSIBILITY_VALIDATION=true

PRESENTATION_VISUAL_QA_ENABLED=true
PRESENTATION_VISUAL_QA_MODEL=gemma4:12b
PRESENTATION_VISUAL_QA_MODE=STANDARD          # STANDARD | STRICT
PRESENTATION_VISUAL_QA_MAX_REPAIRS=2
PRESENTATION_VISUAL_QA_MIN_SCORE=0.80

# ------------------------------------------------------------------------------
# 8. BROWSER & FRONTEND TEST EXECUTION (TIER 3: Test Environment)
# ------------------------------------------------------------------------------
# Optional: path to Chrome / Chromium binary if not in default system locations
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# CHROME_PATH=/usr/bin/google-chrome
BASE_URL=http://localhost:5175
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
